# Required to run the agent. Not needed for `sfagent inspect` or the test suite.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides.
# SFAGENT_MODEL=claude-opus-5
# SFAGENT_EFFORT=high

# Only needed if you swap the mock client for a live Salesforce org.
# See "Pointing it at a real org" in the README.
# SF_USERNAME=you@example.com
# SF_PASSWORD=
# SF_SECURITY_TOKEN=
# SF_DOMAIN=login
